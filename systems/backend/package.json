  "author": "",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/s3-request-presigner": "3.1111.0",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/typeorm": "11.0.3",
    "@vendia/serverless-express": "4.12.6",
    "apollo-server-errors": "3.3.1",
    "apollo-server-express": "3.13.0",
    "aws-lambda": "1.0.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "convict": "6.2.5",
    "dotenv": "17.4.2",
    "graphql": "16.5.0",
    "helmet": "8.3.0",
    "luxon": "2.4.0",
    "pg": "8.23.0",
    "pg-pool": "3.14.0",
    "ramda": "0.32.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "serialize-error": "8.1.0",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.1.0",
    "typeorm-naming-strategies": "4.1.0",
    "uuid": "14.0.1",
    "winston": "3.19.0"
  },
  "description": "",
  "devDependencies": {
    "@busybox/eslint-config": "5.10.0",
    "@busybox/tsconfig": "1.7.1",
    "@jest/globals": "30.4.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@types/aws-lambda": "8.10.162",
    "@types/convict": "6.1.6",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.1",
    "@types/node": "26.2.0",
    "@types/passport-jwt": "4.0.1",
    "@types/ramda": "0.32.0",
    "@types/supertest": "7.2.1",
    "@types/uuid": "11.0.0",
    "eslint": "8.16.0",
    "graphql-tag": "2.12.7",
    "jest": "28.1.0",
    "jest-environment-node": "30.4.1",
    "jest-mock": "28.1.0",
    "supertest": "7.2.2",
    "ts-jest": "28.0.3",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "4.7.2"
  },
  "engines": {
    "node": ">=14",
    "yarn": "Use npm"
  },
  "jest": {
    "collectCoverageFrom": [
      "<rootDir>/**/*.ts",
      "!<rootDir>/**/*.spec.ts",
      "!<rootDir>/migrations/*.ts"
    ],
    "coverageDirectory": "<rootDir>/../coverage",
    "globalSetup": "<rootDir>/test-helpers/jest/e2e-global-setup.js",
    "injectGlobals": false,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testEnvironment": "<rootDir>/test-helpers/jest/e2e-test-environment.js",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "license": "UNLICENSED",
  "name": "backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:lambda": "nest build --webpack -c nest-cli.lambda.json",
    "eslint": "eslint --ext=json,ts,yml",
    "lint": "npx eslint --ext=json,ts,yml --fix .",
    "lint:ci": "npx eslint --ext=json,ts,yml .",
    "migration:create": "npx typeorm migration:create --config ./ormconfig.cli.js",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.http.js",
    "test": "jest --maxWorkers=50%",
    "test:ci": "APP_ENV=test NODE_ENV=test Ci=true jest --coverage --ci --runInBand --bail"
  },
  "version": "1.3.0"
}
